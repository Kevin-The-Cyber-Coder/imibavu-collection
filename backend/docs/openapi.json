{
  "openapi": "3.0.3",
  "info": {
    "title": "Imibavu Collection API",
    "version": "1.0.0",
    "description": "Phase 1: authentication and catalog. All responses use the shape { ... } or { error: { code, message, details } }."
  },
  "servers": [{ "url": "http://localhost:5000/api/v1" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "brand": { "type": "string" },
          "category": { "type": "string", "enum": ["perfumes", "oils", "jewelry"] },
          "price": { "type": "number" },
          "sizes": { "type": "array", "items": { "type": "array", "items": {} } },
          "stock": { "type": "string", "enum": ["in", "low", "out"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "object" },
          "rating": { "type": "number" },
          "reviews": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": { "summary": "Health check", "responses": { "200": { "description": "ok" } } }
    },
    "/auth/register": {
      "post": {
        "summary": "Create an account (phone or email + password)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "name": { "type": "string" },
                  "phone": { "type": "string", "example": "+250788123456" },
                  "email": { "type": "string" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "{ user, accessToken, otp }" },
          "409": { "description": "Account already exists" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Sign in with phone/email + password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["identifier", "password"],
                "properties": {
                  "identifier": { "type": "string", "example": "+250788123456" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ user, accessToken } — refresh token set as httpOnly cookie (path /api/v1/auth)" },
          "401": { "description": "Wrong credentials" },
          "429": { "description": "Too many attempts / account locked" }
        }
      }
    },
    "/auth/otp/send": {
      "post": {
        "summary": "Send an OTP to a phone (purpose: verify_phone | reset_password | login)",
        "responses": { "200": { "description": "{ sent, mode, devCode? } — devCode only when SMS_MODE=console" } }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "summary": "Verify a phone OTP",
        "responses": { "200": { "description": "{ verified: true }" } }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Request a password-reset OTP",
        "responses": { "200": { "description": "{ sent: true, devCode? }" } }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Reset password with phone + OTP + new password",
        "responses": { "200": { "description": "{ reset: true }" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate refresh cookie → new access token",
        "responses": { "200": { "description": "{ accessToken, user }" } }
      }
    },
    "/auth/logout": {
      "post": { "summary": "Revoke refresh token and clear cookie", "responses": { "200": { "description": "{ ok: true }" } } }
    },
    "/auth/me": {
      "get": {
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "{ user }" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/products": {
      "get": {
        "summary": "List products with filters, sorting and pagination",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["perfumes", "oils", "jewelry"] } },
          { "name": "brand", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "gender", "in": "query", "schema": { "type": "string" } },
          { "name": "family", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "minPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "number" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["featured", "newest", "price_asc", "price_desc", "rating", "name"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100 } }
        ],
        "responses": { "200": { "description": "{ items: Product[], total, page, pages }" } }
      }
    },
    "/products/{slug}": {
      "get": {
        "summary": "Single product by slug",
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "{ product }" }, "404": { "description": "Not found" } }
      }
    },
    "/brands": {
      "get": { "summary": "List brands", "responses": { "200": { "description": "{ items: [{ id, name, tag }] }" } } }
    },
    "/brands/{id}": {
      "get": {
        "summary": "Brand with its products",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "{ brand, products: Product[] }" } }
      }
    }
  }
}
