# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ---
MONGODB_USERNAME="mukeshimanakevin20_db_user"
MONGODB_PASSWORD="pHema88Vu5sT8Agb"
MONGODB_URI="mongodb+srv://mukeshimanakevin20_db_user:pHema88Vu5sT8Agb@cluster0.bqu66kj.mongodb.net"

# --- CORS (comma-separated origins allowed to send credentials) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://localhost:5000,http://127.0.0.1:5000

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# --- Admin account created by `npm run seed` ---
ADMIN_NAME=Imibavu Admin
ADMIN_PHONE=+250784804739
ADMIN_EMAIL=admin@imibavucollection.rw
ADMIN_PASSWORD=Admin123

# --- Portal auth (roles, MFA, lockout) ---
# MFA_REQUIRED=true forces staff/admin to set up two-step verification (TOTP)
# and challenges every MFA-enabled account at sign in. Recommended in production.
MFA_REQUIRED=false
MFA_ISSUER=Imibavu Collection
LOCK_MINUTES=15
MAX_FAILED_LOGINS=5
# Optional Google sign-in for customers (Google Identity Services client id).
# Leave empty to disable the /auth/google endpoint.
GOOGLE_CLIENT_ID=

# --- Africa's Talking SMS (OTP) ---
# SMS_MODE=sms sends real messages; SMS_MODE=console logs OTPs to the server console.
SMS_MODE=console
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- Flutterwave payments (Mobile Money / card) ---
# PAYMENTS_MODE=flutterwave charges real money; PAYMENTS_MODE=console simulates locally.
PAYMENTS_MODE=console
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
PAYMENTS_CURRENCY=RWF
PAYMENTS_REDIRECT_URL=http://localhost:8000
API_BASE_URL=http://localhost:5000/api/v1

# --- Optional: order/WhatsApp business number used in messages ---
STORE_PHONE=+250784804739
